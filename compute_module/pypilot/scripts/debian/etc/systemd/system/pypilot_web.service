[Unit]
Description=pypilot web
DefaultDependencies=false
After=pypilot.service

[Service]
Type=simple
# Absolute path (matches pypilot.service); systemd has no guaranteed PATH.
# Runs as innopilot so pypilot_web reads /home/innopilot/.pypilot (calibration
# config) rather than root's home.  Upstream ships this unit with no User= line.
User=innopilot
ExecStart=/usr/local/bin/pypilot_web 8000
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3

[Install]
WantedBy=local-fs.target

